# Copy to .env.local and fill in values. Never commit real values.
# Names follow docs/architecture.md §16. Development uses the Supabase cloud project "certibuy-dev";
# "certibuy-demo" is kept separate for the final demonstration.

# --- Database (Supabase Postgres, used by Prisma) ---
# Pooled connection (transaction mode) for the app at runtime; keep pgbouncer=true.
DATABASE_URL=
# Direct connection for migrations.
DIRECT_URL=

# --- Supabase (Auth + Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
# Public by design; safe in the browser because RLS is on and the Data API is not used.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
APP_PUBLIC_URL=http://localhost:3000
SUPPORT_EMAIL=

# --- Safety flags ---
DEMO_TOOLS_ENABLED=true
REQUIRE_STAFF_MFA=true

# --- Optional free daily cron (off by default) ---
CRON_SECRET=
