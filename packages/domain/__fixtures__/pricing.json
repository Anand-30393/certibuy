{
  "module": "pricing / offer",
  "source": "docs/overview.md.txt §6; docs/architecture.md §9.1",
  "formulas": {
    "gradePrice": "market_price_<grade> ?? market_price_a × grade_factor_<grade>",
    "guaranteed": "round(market × (1 − commission_pct/100) − inspection_fee)",
    "instantCash": "round(market × (1 − commission_pct/100) − inspection_fee − market × risk_pct/100)"
  },
  "cases": [
    {
      "id": "PRC-001",
      "description": "Grade A uses its own market price",
      "status": "confirmed",
      "input": { "fn": "gradePrice", "grade": "A", "model": { "market_price_a": 60000 } },
      "expected": { "market": 60000 }
    },
    {
      "id": "PRC-002",
      "description": "Grade B falls back to A × grade_factor_b when its market price is empty",
      "status": "confirmed",
      "input": {
        "fn": "gradePrice",
        "grade": "B",
        "model": { "market_price_a": 50000, "market_price_b": null }
      },
      "expected": { "market": 45500 }
    },
    {
      "id": "PRC-003",
      "description": "Grade C falls back to A × grade_factor_c",
      "status": "confirmed",
      "input": {
        "fn": "gradePrice",
        "grade": "C",
        "model": { "market_price_a": 50000, "market_price_c": null }
      },
      "expected": { "market": 41000 }
    },
    {
      "id": "PRC-004",
      "description": "Grade D falls back to A × grade_factor_d",
      "status": "confirmed",
      "input": {
        "fn": "gradePrice",
        "grade": "D",
        "model": { "market_price_a": 50000, "market_price_d": null }
      },
      "expected": { "market": 30000 }
    },
    {
      "id": "PRC-005",
      "description": "A filled grade price wins over the fallback factor",
      "status": "confirmed",
      "input": {
        "fn": "gradePrice",
        "grade": "B",
        "model": { "market_price_a": 50000, "market_price_b": 47000 }
      },
      "expected": { "market": 47000 }
    },
    {
      "id": "PRC-006",
      "description": "Offer at market ₹60,000, fast-selling risk 5 %",
      "status": "confirmed",
      "input": { "fn": "offer", "market": 60000, "risk_pct": 5 },
      "expected": {
        "commission": 9000,
        "inspection_fee": 200,
        "risk": 3000,
        "guaranteed": 50800,
        "instant_cash": 47800
      }
    },
    {
      "id": "PRC-007",
      "description": "Offer at market ₹60,000, steady risk 12 %",
      "status": "confirmed",
      "input": { "fn": "offer", "market": 60000, "risk_pct": 12 },
      "expected": { "risk": 7200, "guaranteed": 50800, "instant_cash": 43600 }
    },
    {
      "id": "PRC-008",
      "description": "Offer at the grade-B fallback market ₹45,500, risk 12 %",
      "status": "confirmed",
      "input": { "fn": "offer", "market": 45500, "risk_pct": 12 },
      "expected": { "risk": 5460, "guaranteed": 38475, "instant_cash": 33015 }
    },
    {
      "id": "PRC-009",
      "description": "Offer at market ₹30,000 (grade-D fallback), risk 5 %",
      "status": "confirmed",
      "input": { "fn": "offer", "market": 30000, "risk_pct": 5 },
      "expected": { "guaranteed": 25300, "instant_cash": 23800 }
    },
    {
      "id": "PRC-010",
      "description": "Risk tier: score at or above threshold + near_band (60 + 10) is fast-selling",
      "status": "confirmed",
      "input": { "fn": "riskPct", "score": 72 },
      "expected": { "risk_pct": 5 }
    },
    {
      "id": "PRC-011",
      "description": "Risk tier: score below threshold + near_band is steady",
      "status": "confirmed",
      "input": { "fn": "riskPct", "score": 65 },
      "expected": { "risk_pct": 12 }
    },
    {
      "id": "PRC-012",
      "description": "Risk tier boundary: score exactly 70 is fast-selling (≥)",
      "status": "confirmed",
      "input": { "fn": "riskPct", "score": 70 },
      "expected": { "risk_pct": 5 }
    },
    {
      "id": "PRC-013",
      "description": "Price band: a model inside ₹20,000–₹1,50,000 is selectable",
      "status": "confirmed",
      "input": { "fn": "inPriceBand", "market_price_a": 60000 },
      "expected": { "selectable": true }
    },
    {
      "id": "PRC-014",
      "description": "Price band: a model below ₹20,000 is shown disabled",
      "status": "assumption",
      "notes": "Docs say models outside the band are disabled; they do not say which price is compared. Assumed: market_price_a, inclusive bounds.",
      "input": { "fn": "inPriceBand", "market_price_a": 18000 },
      "expected": { "selectable": false }
    },
    {
      "id": "PRC-015",
      "description": "Offer expiry is offer_expiry_days after the business date it was made",
      "status": "confirmed",
      "input": { "fn": "offerExpiry", "business_date": "2026-11-16" },
      "expected": { "expires_on": "2026-11-23" }
    }
  ]
}
