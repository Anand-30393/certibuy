{
  "module": "daily job rules",
  "source": "docs/automations.md.txt §3; confirmed RET-002 (closing day is inside the window)",
  "cases": [
    {
      "id": "JOB-001",
      "description": "Escrow is not released on the window's closing day",
      "status": "confirmed",
      "input": {
        "fn": "escrowReleasable",
        "orderStatus": "delivered",
        "escrowStatus": "hold",
        "closesAt": "2026-11-24",
        "today": "2026-11-24",
        "hasOpenReturn": false
      },
      "expected": { "result": false }
    },
    {
      "id": "JOB-002",
      "description": "Escrow is released the day after the window closes",
      "status": "confirmed",
      "input": {
        "fn": "escrowReleasable",
        "orderStatus": "delivered",
        "escrowStatus": "hold",
        "closesAt": "2026-11-24",
        "today": "2026-11-25",
        "hasOpenReturn": false
      },
      "expected": { "result": true }
    },
    {
      "id": "JOB-003",
      "description": "An open return blocks the release",
      "status": "confirmed",
      "input": {
        "fn": "escrowReleasable",
        "orderStatus": "delivered",
        "escrowStatus": "hold",
        "closesAt": "2026-11-24",
        "today": "2026-11-30",
        "hasOpenReturn": true
      },
      "expected": { "result": false }
    },
    {
      "id": "JOB-004",
      "description": "Already-released escrow is never released twice",
      "status": "confirmed",
      "input": {
        "fn": "escrowReleasable",
        "orderStatus": "settled",
        "escrowStatus": "released",
        "closesAt": "2026-11-24",
        "today": "2026-11-30",
        "hasOpenReturn": false
      },
      "expected": { "result": false }
    },
    {
      "id": "JOB-005",
      "description": "An offer is still valid on its expiry date and expired the day after",
      "status": "confirmed",
      "input": {
        "fn": "offerExpired",
        "expiresAt": "2026-11-23",
        "todays": ["2026-11-23", "2026-11-24"]
      },
      "expected": { "results": [false, true] }
    },
    {
      "id": "JOB-006",
      "description": "A booked slot becomes a no-show only after its date",
      "status": "confirmed",
      "input": {
        "fn": "isNoShow",
        "bookings": [
          { "status": "booked", "date": "2026-11-20" },
          { "status": "booked", "date": "2026-11-21" },
          { "status": "completed", "date": "2026-11-19" }
        ],
        "today": "2026-11-21"
      },
      "expected": { "results": [true, false, false] }
    },
    {
      "id": "JOB-007",
      "description": "Reminders fire from 3 days before the deadline up to the deadline day",
      "status": "confirmed",
      "input": {
        "fn": "reminderDue",
        "deadline": "2026-11-24",
        "todays": ["2026-11-20", "2026-11-21", "2026-11-24", "2026-11-25"],
        "windowDays": 3
      },
      "expected": { "results": [false, true, true, false] }
    },
    {
      "id": "JOB-008",
      "description": "Held days for a reserved listing never decrease",
      "status": "confirmed",
      "input": {
        "fn": "heldDays",
        "cases": [
          [0, "2026-11-20", "2026-11-22"],
          [5, "2026-11-20", "2026-11-22"]
        ]
      },
      "expected": { "results": [3, 5] }
    },
    {
      "id": "JOB-009",
      "description": "The ladder only steps down",
      "status": "confirmed",
      "input": {
        "fn": "ladderAdvances",
        "cases": [
          [0, 1],
          [1, 1],
          [2, 0]
        ]
      },
      "expected": { "results": [true, false, false] }
    }
  ]
}
