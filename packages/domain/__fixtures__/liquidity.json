      "expected": { "score": 80, "source": "cold_start" }
    },
    {
      "id": "LIQ-002",
      "description": "Cold start, medium tier, one day-45 return (−6)",
      "status": "confirmed",
      "input": { "measured_sales": 2, "tier": "medium", "day45_returns": 1 },
      "expected": { "score": 59, "source": "cold_start" }
    },
    {
      "id": "LIQ-003",
      "description": "Cold start, low tier, two day-45 returns",
      "status": "confirmed",
      "input": { "measured_sales": 1, "tier": "low", "day45_returns": 2 },
      "expected": { "score": 33, "source": "cold_start" }
    },
    {
      "id": "LIQ-004",
      "description": "Score is clamped at 0",
      "status": "confirmed",
      "input": { "measured_sales": 0, "tier": "low", "day45_returns": 8 },
      "expected": { "score": 0 }
    },
    {
      "id": "LIQ-005",
