{
  "name": "@certibuy/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Prisma schema, portable SQL migrations, Supabase-only SQL and seeds.",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1"
  },
  "devDependencies": {
    "prisma": "~7.10.1",
    "tsx": "^4.23.15"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "supabase:apply": "prisma db execute --file supabase/001_supabase.sql",
    "seed": "tsx seed/seed.ts",
    "postinstall": "prisma generate"
  }
}
