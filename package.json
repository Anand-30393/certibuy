{
  "name": "certibuy",
  "private": true,
  "type": "module",
  "description": "CertiBuy — custody-first refurbished-device marketplace (capstone rebuild). See docs/architecture.md.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @certibuy/web dev",
    "build": "corepack pnpm --filter @certibuy/web build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node --env-file=.env.local e2e/run.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "eslint . && tsc -p tsconfig.json && vitest run && prettier --check ."
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
